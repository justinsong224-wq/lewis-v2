# Copy to .env at repository root and fill your own compatible service settings.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=
LLM_MODEL=
LLM_JSON_MODE=prompt
LLM_TIMEOUT_SECONDS=90
AGENT_TIMEOUT_SECONDS=240
SERPER_API_KEY=
# Empty disables optional Redis; SQLite still provides history and event replay.
REDIS_URL=
